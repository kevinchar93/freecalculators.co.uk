# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=freecalculators.co.uk
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME="${APP_NAME}"

# Session
SESSION_DRIVER=cookie

# Set STAGING_BASIC_AUTH_ENABLED=true only on the staging environment.
# STAGING_BASIC_AUTH_PASSWORD_HASH is a bcrypt hash generated with
# `node ace hash:password` — never store the plaintext password here.
STAGING_BASIC_AUTH_ENABLED=false
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD_HASH=